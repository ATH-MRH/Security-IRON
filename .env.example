PORT=3000
JWT_SECRET=

# PostgreSQL: provide a complete secret URL, or explicit PG* fields below.
# DATABASE_URL must not contain query parameters; configure TLS separately.
DATABASE_URL=
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Verified TLS by default. Use disable explicitly for a dedicated local cluster.
PGSSL=verify-full
# Optional trusted server CA PEM file:
# PGSSLROOTCERT=
PGPOOL_MAX=10
PGCONNECT_TIMEOUT_MS=5000
PGIDLE_TIMEOUT_MS=30000
PGSTATEMENT_TIMEOUT_MS=15000
PGTRANSACTION_IDLE_TIMEOUT_MS=60000

# Dedicated local database named securisite_test or securisite_test_<suffix> only.
# Tests never fall back to DATABASE_URL.
# SECURISITE_TEST_DATABASE_URL=
# SECURISITE_TEST_PGSSL=disable
