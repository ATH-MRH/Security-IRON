{
  "name": "securisite",
  "version": "1.0.0",
  "description": "SécuriSite — SOC / Centre de Sûreté du Site (gestion d'événements, accès, parking, LAPI)",
  "main": "electron/main.js",
  "scripts": {
    "server": "node server.js",
    "dev": "node --watch server.js",
    "db:roles": "node backend/db/postgresql/provision-roles.js",
    "db:migrate": "node backend/db/postgresql/migrate-cli.js",
    "db:create-admin": "node backend/db/postgresql/create-admin.js",
    "db:bootstrap-admin-membership": "node backend/db/postgresql/bootstrap-admin-membership.js",
    "db:create-first-admin": "node backend/db/postgresql/create-first-admin-cli.js",
    "db:import": "node backend/db/postgresql/import-sqlite.js",
    "db:backup": "node backend/db/postgresql/backup-cli.js",
    "db:restore": "node backend/db/postgresql/restore-cli.js",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg",
    "test": "node --test tests/*.test.js",
    "test:pg": "node tests/helpers/run-postgres-tests.js"
  },
  "keywords": [
    "security",
    "soc",
    "access-control",
    "lapi",
    "parking"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.irongs.securisite",
    "productName": "SecuriSite",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "backend/**/*",
      "frontend/**/*",
      "electron/main.js",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SecuriSite"
    },
    "portable": {
      "artifactName": "SecuriSite-portable-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
