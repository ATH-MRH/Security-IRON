{
  "name": "securisite",
  "version": "1.0.0",
  "description": "SécuriSite — SOC / Centre de Sûreté du Site (gestion d'événements, accès, parking, LAPI)",
  "main": "electron/main.js",
  "scripts": {
    "server": "node server.js",
    "dev": "node --watch server.js",
    "init-db": "node backend/seed.js",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg"
  },
  "keywords": [
    "security",
    "soc",
    "access-control",
    "lapi",
    "parking"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.3.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.irongs.securisite",
    "productName": "SecuriSite",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "backend/**/*",
      "frontend/**/*",
      "electron/main.js",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SecuriSite"
    },
    "portable": {
      "artifactName": "SecuriSite-portable-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
